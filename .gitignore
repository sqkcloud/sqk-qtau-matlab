# macOS
.DS_Store
.AppleDouble
.LSOverride

# MATLAB
*.asv
*.m~
*.mex*
slprj/
sccprj/
codegen/
*.slxc

# Output — generated logs, plots, reports (keep the folder, ignore contents)
output/*
!output/.gitkeep

# Root-level session artifacts produced by the running app. These are
# written to the working directory by ReportService / ExportService /
# QmcService and should never end up in the toolbox package or git
# history.
Report_*.pdf
EmAnalysis_*.json
ExecLog_*.jsonl
Results_*.json
Reconstruction_*.json

# Claude Code transient lock files
.claude/scheduled_tasks.lock

# Toolbox packaging output — generated .mltbx files
release/
*.mltbx

# Secrets and credentials
.env
.env.*
!.env.example
credentials*
secrets/
*.token
.secret*
resources/seed.properties
doc/keys.txt

# Claude Code local settings (may contain tokens)
.claude/settings.local.json

# Project metadata
.serena/
